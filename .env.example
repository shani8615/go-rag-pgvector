# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=<your-api-key>

# Optional: any OpenAI-compatible endpoint (Ollama, vLLM, a gateway, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536
# CHAT_MODEL=gpt-4o-mini

# Retrieval tuning
# TOP_K=5
# MIN_SCORE=0.30

# Run without any API key (keyword search + extractive answers, for trying the API)
# OFFLINE_DEMO=1
